          "root_selector": "aggregations.by_device.buckets.(\n  $total := doc_count;\n  $byMajor := versions.buckets{ $substringBefore(key, \".\"): $sum(doc_count) };\n  $rows := $each($byMajor, function($v, $k) { {\"major\": $k, \"count\": $v} });\n  $numeric := $filter($rows, function($r) { $contains($r.major, /^[0-9]+$/) });\n  $sorted := $sort($numeric, function($a, $b) { $number($a.major) < $number($b.major) });\n  $ranked := $map($sorted, function($r, $i) { {\"major\": $r.major, \"count\": $r.count, \"i\": $i} });\n  $qual := $filter($ranked, function($r) { $r.count / $total >= 0.05 });\n  $c := $exists($qual) ? $qual[0].i : 0;\n  $curMajor := $ranked[i = $c].major;\n  {\n    \"browser\": $exists($curMajor) ? key & \" (v\" & $curMajor & \")\" : key,\n    \"current\": $sum([$ranked[i <= $c].count, 0]) / $total,\n    \"behind1\": $sum([$ranked[i = $c + 1].count, 0]) / $total,\n    \"behind2\": $sum([$ranked[i = $c + 2].count, 0]) / $total,\n    \"behind3\": $sum([$ranked[i > $c + 2].count, 0]) / $total,\n    \"unknown\": ($total - $sum([$ranked.count, 0])) / $total\n  }\n)",
