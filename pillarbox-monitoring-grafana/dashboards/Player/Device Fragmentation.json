          "root_selector": "(\n  $vkey := function($v) {(\n    $p := $split($v, \".\");\n    $n := function($i) { $exists($p[$i]) and $contains($p[$i], /^[0-9]+$/) ? $number($p[$i]) : 0 };\n    $n(0) * 1000000 + $n(1) * 1000 + $n(2)\n  )};\n  $cols := $sort(aggregations.by_col.buckets, function($a, $b) { $vkey($a.key) < $vkey($b.key) });\n  $totals := $cols.errors.by_type.buckets{ key: $sum(doc_count) };\n  $types := $sort($keys($totals), function($a, $b) { $lookup($totals, $a) < $lookup($totals, $b) });\n  $types.(\n    $t := $;\n    $cols.(\n      $starts := starts.doc_count;\n      {\n        \"error_type\": $t,\n        \"column\": \"v\" & key,\n        \"value\": $starts > 0 ? $sum([errors.by_type.buckets[key = $t].doc_count, 0]) / $starts : null\n      }\n    )\n  )\n)",
