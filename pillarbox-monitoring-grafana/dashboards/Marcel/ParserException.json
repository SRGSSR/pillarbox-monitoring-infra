          },
          "filters": [],
          "format": "table",
          "global_query_id": "",
          "parser": "backend",
          "refId": "A",
          "root_selector": "$filter(\n  $append(\n    $map(aggregations.web_apps.by_application.buckets, function($b) {\n      {\n        \"platform_type\": \"Web\",\n        \"platform_detail\": \"Browser\",  /* Could extract from data */\n        \"application\": $b.key,\n        \"starts\": $b.starts.doc_count,\n        \"errors\": $b.errors.doc_count,\n        \"error_rate\": $b.error_rate.value,\n        \"p50_load_time\": $b.p50_load_time.percentile.values.\"50.0\"\n      }\n    }),\n    $map(aggregations.mobile_apps.by_application.buckets, function($b) {\n      {\n        \"platform_type\": \"Mobile\",\n        \"platform_detail\": $b.platform.value,  /* e.g., \"iOS\", \"Android\" */\n        \"application\": $b.key,\n        \"starts\": $b.starts.doc_count,\n        \"errors\": $b.errors.doc_count,\n        \"error_rate\": $b.error_rate.value,\n        \"p50_load_time\": $b.p50_load_time.percentile.values.\"50.0\"\n      }\n    })\n  ),\n  function($row) {\n    $row.starts >= $number($_min_starts) \n    and\n   (\"${platform}\" = \"All\" \n   or \n   $row.platform_type = \"${platform}\")\n  }\n)",
          "source": "url",
          "type": "json",
          "url": "",
          "url_options": {
            "body_content_type": "application/json",
            "body_type": "raw",
            "data": "{\r\n  \"size\": 0,\r\n  \"query\": {\r\n    \"bool\": {\r\n      \"filter\": [\r\n        {\r\n          \"range\": {\r\n            \"@timestamp\": {\r\n              \"gte\": \"${__from}\",\r\n              \"lte\": \"${__to}\"\r\n            }\r\n          }\r\n        },\r\n        { \"terms\": { \"event_name\": [\"ERROR\", \"START\"] } }\r\n      ]\r\n    }\r\n  },\r\n  \"aggs\": {\r\n    \"web_apps\": {\r\n      \"filter\": {\r\n        \"bool\": {\r\n          \"must_not\": [\r\n            { \"terms\": { \"session.player.platform\": [\"Android\", \"android\", \"Apple\"] } }\r\n          ]\r\n        }\r\n      },\r\n      \"aggs\": {\r\n        \"by_application\": {\r\n          \"terms\": {\r\n            \"field\": \"session.media.short_origin\",\r\n            \"size\": 500,\r\n            \"order\": { \"errors\": \"desc\" }\r\n          },\r\n          \"aggs\": {\r\n            \"errors\": {\r\n              \"filter\": {\r\n                \"bool\": {\r\n                  \"filter\": [\r\n                    { \"term\": { \"event_name\": \"ERROR\" } },\r\n                    { \"term\": { \"data.business_error\": false } }\r\n                  ],\r\n                  \"must_not\": [\r\n                    { \"terms\": { \"data.error_type\": [\"DRM_NOT_SUPPORTED\", \"CONNECTION_ERROR\", \"STARTDATE\", \"PLAYBACK_UNSUPPORTED_MEDIA\"] }},\r\n\t\t\t\t\t{ \"terms\": { \"data.name\": [\"MEDIA_ERR_CUSTOM: 0\", \"MEDIA_ERR_ABORTED: 1\"] } }\r\n                  ]\r\n                }\r\n              }\r\n            },\r\n            \"starts\": {\r\n              \"filter\": { \"term\": { \"event_name\": \"START\"} }\r\n            },\r\n            \"error_rate\": {\r\n              \"bucket_script\": {\r\n                \"buckets_path\": { \"err\": \"errors>_count\", \"sess\": \"starts>_count\" },\r\n                \"script\": \"params.sess > 0 ? params.err / params.sess : 0\"\r\n              }\r\n            },\r\n            \"p50_load_time\": {\r\n              \"filter\": { \"term\": { \"event_name\": \"START\" } },\r\n              \"aggs\": {\r\n                \"percentile\": {\r\n                  \"percentiles\": {\r\n                    \"field\": \"session.qoe_timings.total\",\r\n                    \"percents\": [50]\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n\r\n    \"mobile_apps\": {\r\n      \"filter\": {\r\n        \"terms\": { \"session.player.platform\": [\"Android\", \"android\", \"Apple\"] }\r\n      },\r\n      \"aggs\": {\r\n        \"by_application\": {\r\n          \"terms\": {\r\n            \"field\": \"session.application.id\",\r\n            \"size\": 500,\r\n            \"order\": { \"errors\": \"desc\" }\r\n          },\r\n          \"aggs\": {\r\n            \"errors\": {\r\n              \"filter\": {\r\n                \"bool\": {\r\n                  \"filter\": [\r\n                    { \"term\": { \"event_name\": \"ERROR\" } },\r\n                    { \"term\": { \"data.business_error\": false } }\r\n                  ],\r\n                  \"must_not\": [\r\n                    { \"terms\": { \"data.error_type\": [\"DRM_NOT_SUPPORTED\", \"CONNECTION_ERROR\"] } }\r\n                  ]\r\n                }\r\n              }\r\n            },\r\n            \"starts\": {\r\n              \"filter\": { \"term\": { \"event_name\": \"START\"} }\r\n            },\r\n            \"error_rate\": {\r\n              \"bucket_script\": {\r\n                \"buckets_path\": { \"err\": \"errors>_count\", \"sess\": \"starts>_count\" },\r\n                \"script\": \"params.sess > 0 ? params.err / params.sess : 0\"\r\n              }\r\n            },\r\n            \"p50_load_time\": {\r\n              \"filter\": { \"term\": { \"event_name\": \"START\" } },\r\n              \"aggs\": {\r\n                \"percentile\": {\r\n                  \"percentiles\": {\r\n                    \"field\": \"session.qoe_timings.total\",\r\n                    \"percents\": [50]\r\n                  }\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n}",
            "method": "POST"
          }
        }
